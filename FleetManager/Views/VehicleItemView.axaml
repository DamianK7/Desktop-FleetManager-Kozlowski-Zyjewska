<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FleetManager.ViewModels"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="200"
             x:Class="FleetManager.Views.VehicleItemView"
             x:DataType="vm:VehicleItemViewModel">

    <Border Margin="6,4"
            Background="#1c2333"
            BorderBrush="#2e3d55"
            BorderThickness="1"
            CornerRadius="6"
            Padding="14,12">

        <StackPanel Spacing="8">

            <TextBlock Text="{Binding Name}"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#e2e8f0"/>
            
            <TextBlock Text="{Binding RegistrationNumber}"
                       FontSize="11"
                       Foreground="#64748b"/>

            <TextBlock Text="{Binding Status}"
                       FontSize="12"
                       Foreground="#94a3b8"/>

            <TextBlock Text="{Binding Fuel, StringFormat='Paliwo: {0}%'}"
                       FontSize="12"
                       Foreground="#94a3b8"/>

            <ProgressBar Value="{Binding Fuel}"
                         Minimum="0"
                         Maximum="100"
                         Height="8"
                         Width="200"
                         HorizontalAlignment="Left"/>


            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">

                <Button Content="Wyślij w trasę"
                        Command="{Binding SendCommand}"/>

                <Button Content="Tankuj"
                        Command="{Binding RefuelCommand}"/>

                <Button Content="Serwis"
                        Command="{Binding SetServiceCommand}"/>

                <Button Content="Dostępny"
                        Command="{Binding SetAvailableCommand}"/>

            </StackPanel>

        </StackPanel>
    </Border>

</UserControl>