<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FleetManager.ViewModels"
        xmlns:views="clr-namespace:FleetManager.Views"
        x:Class="FleetManager.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="SwiftTrans Fleet Manager"
        Width="620" Height="600"
        Background="#0f172a">
<ScrollViewer>
    <StackPanel Margin="16" Spacing="8">

        <TextBlock Text="Fleet Manager"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#f1f5f9"
                   Margin="0,0,0,12"/>

        <ListBox ItemsSource="{Binding Vehicles}"
                 Background="Transparent"
                 BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <views:VehicleItemView/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </StackPanel>
</ScrollViewer>
</Window>